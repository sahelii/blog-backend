# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=your_mongodb_uri
# or: MONGODB_URI=your_mongodb_uri

# Auth
JWT_SECRET=your_jwt_secret

# CORS (required in production for frontend to call API)
# Comma-separated list of allowed origins (no spaces after commas)
CORS_ALLOWED_ORIGINS=https://blog-frontend-sigma-ecru.vercel.app
# Legacy: single frontend URL (also supported)
# FRONTEND_URL=https://blog-frontend-sigma-ecru.vercel.app

# Firebase (for admin/auth)
# FIREBASE_TYPE=service_account
# FIREBASE_PROJECT_ID=...
# FIREBASE_PRIVATE_KEY_ID=...
# FIREBASE_PRIVATE_KEY=...
# FIREBASE_CLIENT_EMAIL=...
# FIREBASE_CLIENT_ID=...
# FIREBASE_AUTH_URI=...
# FIREBASE_TOKEN_URI=...
# FIREBASE_AUTH_PROVIDER_X509_CERT_URL=...
# FIREBASE_CLIENT_X509_CERT_URL=...

# Cloudinary (optional, for image uploads)
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# Redis (optional, for caching)
# REDIS_URL=redis://localhost:6379
